    {
      "name": "search_designs",
      "title": "Search motion, branding and decks",
      "description": "Find imported references. family=decks is presentations; branding includes identities and guidelines; sections is imported components; motion is source video. Use get_design_taxonomy for tags.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 300
          },
          "family": {
            "type": "string",
            "enum": [
              "motion",
              "sections",
              "branding",
              "decks",
              "collections"
            ]
