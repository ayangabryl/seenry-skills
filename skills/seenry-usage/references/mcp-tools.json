            "type": "string",
            "maxLength": 300
          },
          "style": {
            "type": "string",
            "maxLength": 300
          },
          "platform": {
            "type": "string",
            "maxLength": 300
          },
          "tag": {
            "type": "string",
            "maxLength": 300
          },
          "tag_status": {
            "type": "string",
            "enum": [
              "tagged",
              "needs_review"
            ]
          },
          "sort": {
            "default": "relevance",
            "type": "string",
            "enum": [
              "relevance",
              "newest",
              "top_rated",
              "resolution"
            ]
          },
          "min_rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "min_short_edge": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3840
          },
          "limit": {
            "default": 12,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
